{
  "name": "teacher-app",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación de escritorio para el docente con evaluación oral asistida por IA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.antigravity.ia-speaking-assistant",
    "productName": "IA Speaking Assistant - Teacher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      ".env",
      "!dist/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IA Speaking Assistant - Teacher"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.45.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.5",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  }
}
